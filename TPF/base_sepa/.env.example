# Copiar como .env (no se versiona) y completar.
# Clave gratuita de OpenRouteService (https://openrouteservice.org/dev/#/signup): rutas peatonales reales para
# calcular el tiempo caminando hasta cada supermercado. Sin ella, la página estima el tiempo por distancia y lo avisa.
ORS_API_KEY=

# Clave gratuita de Groq (https://console.groq.com/keys): "Contalo con tus palabras" en la página local
# (python -m canasta). Un LLM traduce el texto libre al formulario, que la persona revisa antes de calcular. Solo la usa
# el servidor local: nunca va en ninguna página. Sin ella, el bloque no se ofrece.
GROQ_API_KEY=
